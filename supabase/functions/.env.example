# Copy to .env (git-ignored). The worker's WORKER_SECRET must be the same value.
WORKER_URL=http://host.docker.internal:8090
WORKER_SECRET=
# Local only: inside the edge runtime SUPABASE_URL is the internal http://kong:8000, so links meant for a
# browser (export ZIP) are rewritten to this address. Leave it unset in the hosted project.
PUBLIC_API_URL=http://127.0.0.1:54321
# Claude (write-listing, read-report). Locally the integration tests' fake answers on the host:
# ANTHROPIC_API_KEY=test-key and ANTHROPIC_BASE_URL=http://host.docker.internal:8091. In the hosted project
# only the key is set, as a function secret; an empty base URL means the SDK default.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Scheduled report cleanup (clean-reports): the cron job sends this as x-cron-secret. Same value as the Vault entry cron_secret.
CRON_SECRET=
