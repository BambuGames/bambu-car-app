# Copy to .env (git-ignored). The worker's WORKER_SECRET must be the same value.
WORKER_URL=http://host.docker.internal:8090
WORKER_SECRET=
# Local only: inside the edge runtime SUPABASE_URL is the internal http://kong:8000, so links meant for a
# browser (export ZIP) are rewritten to this address. Leave it unset in the hosted project.
PUBLIC_API_URL=http://127.0.0.1:54321
